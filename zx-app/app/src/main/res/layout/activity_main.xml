<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zx_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_zx"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:text="ZX • AYOUB"
                android:textColor="@color/zx_purple"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="FREE FIRE • MOD MENU"
                android:textColor="@color/zx_text_dim"
                android:textSize="11sp"
                android:letterSpacing="0.4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- ══ STATUS CARD ═════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/bg_status_inactive"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/dot_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#2D2D42"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:text="INACTIVE"
                android:textColor="@color/zx_text_dim"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_status_sub"
                android:text="Ready"
                android:textColor="@color/zx_text_muted"
                android:textSize="11sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ══ AIM SYSTEM ════════════════════════════════════════════════════ -->
        <TextView
            android:text="  AIM SYSTEM"
            android:textColor="@color/zx_text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="16dp">

            <!-- Master enable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_aim"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Aim System" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="AI-assisted bone targeting" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_aim_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    style="@style/ZxSwitch"/>
            </LinearLayout>

            <!-- Collapsible aim controls -->
            <LinearLayout
                android:id="@+id/ll_aim_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border"/>

                <!-- Bone target buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:text="BONE TARGET"
                        android:textColor="@color/zx_text_dim"
                        android:textSize="9sp"
                        android:letterSpacing="0.4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_bone_ai"
                            android:text="AI"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bone_btn_sel"
                            android:textColor="@color/zx_purple"
                            android:stateListAnimator="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <View android:layout_width="8dp" android:layout_height="match_parent"/>

                        <Button
                            android:id="@+id/btn_bone_neck"
                            android:text="NECK"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bone_btn_unsel"
                            android:textColor="@color/zx_text_dim"
                            android:stateListAnimator="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                        <View android:layout_width="8dp" android:layout_height="match_parent"/>

                        <Button
                            android:id="@+id/btn_bone_head"
                            android:text="HEAD"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_bone_btn_unsel"
                            android:textColor="@color/zx_text_dim"
                            android:stateListAnimator="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>

                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:marginStart="18dp"/>

                <!-- FOV precision slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="2dp">
                        <TextView
                            android:text="PRECISION  (FOV)"
                            android:textColor="@color/zx_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/tv_aim_fov"
                            android:text="35°"
                            android:textColor="@color/zx_purple"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sl_aim_fov"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="5"
                        android:valueTo="90"
                        android:value="35"
                        android:stepSize="1"
                        style="@style/ZxSliderPurple"/>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:marginStart="18dp"/>

                <!-- Smooth/prediction slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="2dp">
                        <TextView
                            android:text="SMOOTH"
                            android:textColor="@color/zx_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/tv_aim_smooth"
                            android:text="60%"
                            android:textColor="@color/zx_purple"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sl_aim_smooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:value="60"
                        android:stepSize="1"
                        style="@style/ZxSliderPurple"/>

                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:marginStart="54dp"/>

            <!-- Wide FOV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_esp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Wide FOV" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Extended field of view" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_wide_pov"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══ WEAPON SECTION ═════════════════════════════════════════════ -->
        <TextView
            android:text="  WEAPON"
            android:textColor="@color/zx_text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="16dp">

            <!-- Anti Recoil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_recoil"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Anti Recoil" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Zero vertical climb" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_anti_recoil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:marginStart="54dp"/>

            <!-- No Spread -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_recoil"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="No Spread" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Pinpoint bullet accuracy" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_no_spread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:marginStart="54dp"/>

            <!-- Rapid Fire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_zx"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Rapid Fire" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Maximum fire rate" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_rapid_fire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══ VISUAL SECTION ════════════════════════════════════════════ -->
        <TextView
            android:text="  VISUAL"
            android:textColor="@color/zx_text_dim"
            android:textSize="10sp"
            android:letterSpacing="0.5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="24dp">

            <!-- ESP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_esp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="ESP Boxes" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Neon outline through walls" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_esp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══ RISK SECTION ══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:text="  RISK ZONE"
                android:textColor="@color/zx_amber"
                android:textSize="10sp"
                android:letterSpacing="0.5"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:text="⚠ HIGH RISK"
                android:textColor="@color/zx_amber"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:background="@drawable/bg_risk_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_risk"
            android:layout_marginBottom="24dp">

            <!-- ── Speed Hack ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_speed"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:text="Speed Hack" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text=" HIGH RISK" android:textColor="@color/zx_amber" android:textSize="9sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <TextView android:text="Player movement multiplier" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_speed_hack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
            <!-- Speed slider row (hidden by default) -->
            <LinearLayout
                android:id="@+id/row_speed_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="52dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="15"
                    android:stepSize="1"
                    style="@style/ZxSlider"/>
                <TextView
                    android:id="@+id/tv_speed_val"
                    android:text="15%"
                    android:textColor="@color/zx_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:marginStart="54dp"/>

            <!-- ── Rapid Fire Intensity ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_zx"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Rapid Fire Rate" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Fire rate intensity boost" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_rapid_fire_risk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_rapid_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="52dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_rapid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="50"
                    android:stepSize="1"
                    style="@style/ZxSlider"/>
                <TextView
                    android:id="@+id/tv_rapid_val"
                    android:text="50%"
                    android:textColor="@color/zx_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:marginStart="54dp"/>

            <!-- ── Vehicle Speed ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_speed"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Vehicle Speed" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Vehicle movement multiplier" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_vehicle_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_vehicle_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="52dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_vehicle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="30"
                    android:stepSize="1"
                    style="@style/ZxSlider"/>
                <TextView
                    android:id="@+id/tv_vehicle_val"
                    android:text="30%"
                    android:textColor="@color/zx_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:marginStart="54dp"/>

            <!-- ── High Jump ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_aim"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="High Jump" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Jump height multiplier" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_high_jump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_jump_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="52dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_jump"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="40"
                    android:stepSize="1"
                    style="@style/ZxSlider"/>
                <TextView
                    android:id="@+id/tv_jump_val"
                    android:text="40%"
                    android:textColor="@color/zx_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"/>
            </LinearLayout>


            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:marginStart="54dp"/>

            <!-- ── No Grass ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_esp"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="No Grass" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Strip ground foliage — clear visibility" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_no_grass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:marginStart="54dp"/>

            <!-- ── Anti Damage ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_recoil"
                    android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:text="Anti Damage" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text=" HIGH RISK" android:textColor="@color/zx_amber" android:textSize="9sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <TextView android:text="Incoming damage reduction %" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_anti_damage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ZxSwitch"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_damage_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="52dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">
                <com.google.android.material.slider.Slider
                    android:id="@+id/sl_damage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="50"
                    android:stepSize="1"
                    style="@style/ZxSlider"/>
                <TextView
                    android:id="@+id/tv_damage_val"
                    android:text="50%"
                    android:textColor="@color/zx_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ══ ACTION BUTTONS ══════════════════════════════════════════════ -->
        <Button
            android:id="@+id/btn_activate"
            android:text="ACTIVATE MOD"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_activate"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btn_stop"
            android:text="DEACTIVATE"
            android:textColor="@color/zx_text_dim"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_stop"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null"/>

        <!-- ══ FOOTER ══════════════════════════════════════════════════════ -->
        <TextView
            android:text="Root required  •  Launch Free Fire before activating"
            android:textColor="@color/zx_text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
