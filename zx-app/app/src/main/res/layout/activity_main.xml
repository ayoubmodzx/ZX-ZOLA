<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zx_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══ WOLF HERO ════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="40dp"
            android:paddingBottom="32dp"
            android:background="@drawable/bg_hero_section">

            <!-- Wolf logo inside glowing ring -->
            <FrameLayout
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:layout_marginBottom="18dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_wolf_ring"/>

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/ic_logo_wolf"
                    android:scaleType="centerInside"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <!-- Brand name -->
            <TextView
                android:text="ZX"
                android:textColor="@color/zx_purple"
                android:textSize="48sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="-4dp"/>

            <TextView
                android:text="by AYOUB"
                android:textColor="#6060A0"
                android:textSize="13sp"
                android:letterSpacing="0.22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>

            <View
                android:layout_width="60dp"
                android:layout_height="1dp"
                android:background="#337C4DFF"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:text="FREE FIRE  ·  MOD MENU  ·  v3.0"
                android:textColor="#3A3A6A"
                android:textSize="9sp"
                android:letterSpacing="0.4"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ══ CONTENT BELOW HERO ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── STATUS CARD ── -->
            <LinearLayout
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_status_inactive"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/dot_status"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#2D2D42"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/tv_status"
                    android:text="INACTIVE"
                    android:textColor="@color/zx_text_dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_status_sub"
                    android:text="Ready"
                    android:textColor="@color/zx_text_muted"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ── ZYGISK MODULE STATUS ── -->
            <LinearLayout
                android:id="@+id/card_module_status"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_status_inactive"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/dot_module"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#2D2D42"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/tv_module_status"
                    android:text="MODULE NOT FOUND"
                    android:textColor="@color/zx_text_dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tv_module_sub"
                    android:text="Zygisk?"
                    android:textColor="@color/zx_text_muted"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ── CONTROL BUTTONS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_activate"
                    android:text="ACTIVATE"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_activate"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btn_stop"
                    android:text="STOP"
                    android:textColor="@color/zx_text_dim"
                    android:textSize="13sp"
                    android:letterSpacing="0.12"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_stop"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_float_icon"
                android:text="FLOATING ICON  ○"
                android:textColor="@color/zx_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_stop"
                android:layout_marginBottom="28dp"
                android:stateListAnimator="@null"/>

            <!-- ══ AIM SYSTEM ══════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="@color/zx_purple" android:layout_marginEnd="8dp"/>
                <TextView
                    android:text="AIM SYSTEM"
                    android:textColor="@color/zx_text_dim"
                    android:textSize="10sp"
                    android:letterSpacing="0.5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glow"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_aim" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Aim System" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="AI-assisted bone targeting" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_aim_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        style="@style/ZxSwitch"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_aim_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:text="BONE TARGET"
                            android:textColor="@color/zx_text_dim"
                            android:textSize="9sp"
                            android:letterSpacing="0.4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
                            <Button android:id="@+id/btn_bone_ai" android:text="AI" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_bone_btn_sel" android:textColor="@color/zx_purple" android:stateListAnimator="@null" android:insetTop="0dp" android:insetBottom="0dp"/>
                            <View android:layout_width="8dp" android:layout_height="match_parent"/>
                            <Button android:id="@+id/btn_bone_neck" android:text="NECK" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_bone_btn_unsel" android:textColor="@color/zx_text_dim" android:stateListAnimator="@null" android:insetTop="0dp" android:insetBottom="0dp"/>
                            <View android:layout_width="8dp" android:layout_height="match_parent"/>
                            <Button android:id="@+id/btn_bone_head" android:text="HEAD" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_bone_btn_unsel" android:textColor="@color/zx_text_dim" android:stateListAnimator="@null" android:insetTop="0dp" android:insetBottom="0dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:layout_marginStart="18dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:text="PRECISION  (FOV)" android:textColor="@color/zx_text_dim" android:textSize="9sp" android:letterSpacing="0.4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                            <TextView android:id="@+id/tv_aim_fov" android:text="35°" android:textColor="@color/zx_purple" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider android:id="@+id/sl_aim_fov" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="5" android:valueTo="90" android:value="35" android:stepSize="1" style="@style/ZxSliderPurple"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:layout_marginStart="18dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="14dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="2dp">
                            <TextView android:text="SMOOTH" android:textColor="@color/zx_text_dim" android:textSize="9sp" android:letterSpacing="0.4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                            <TextView android:id="@+id/tv_aim_smooth" android:text="50%" android:textColor="@color/zx_purple" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <com.google.android.material.slider.Slider android:id="@+id/sl_aim_smooth" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:value="50" android:stepSize="1" style="@style/ZxSliderPurple"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:layout_marginStart="54dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_esp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Wide FOV" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Extended field of view" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_wide_pov" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ WEAPON ══════════════════════════════════════════════════ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="@color/zx_purple" android:layout_marginEnd="8dp"/>
                <TextView android:text="WEAPON" android:textColor="@color/zx_text_dim" android:textSize="10sp" android:letterSpacing="0.5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_glow" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_recoil" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Anti Recoil" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Zero vertical climb" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_anti_recoil" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:layout_marginStart="54dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_recoil" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="No Spread" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Pinpoint bullet accuracy" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_no_spread" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/zx_border" android:layout_marginStart="54dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_zx" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Rapid Fire" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Maximum fire rate" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_rapid_fire" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ VISUAL ══════════════════════════════════════════════════ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="@color/zx_purple" android:layout_marginEnd="8dp"/>
                <TextView android:text="VISUAL" android:textColor="@color/zx_text_dim" android:textSize="10sp" android:letterSpacing="0.5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_glow" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_esp" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="ESP Boxes" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Neon outline through walls" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_esp" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ RISK ZONE ════════════════════════════════════════════════ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp" android:background="@color/zx_amber" android:layout_marginEnd="8dp"/>
                <TextView android:text="RISK ZONE" android:textColor="@color/zx_amber" android:textSize="10sp" android:letterSpacing="0.5" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="⚠ HIGH RISK" android:textColor="@color/zx_amber" android:textSize="9sp" android:letterSpacing="0.2" android:background="@drawable/bg_risk_badge" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_risk" android:layout_marginBottom="24dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_speed" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:text="Speed Hack" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text=" HIGH RISK" android:textColor="@color/zx_amber" android:textSize="9sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
                        </LinearLayout>
                        <TextView android:text="Player movement multiplier" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_speed_hack" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ZxSwitch"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/row_speed_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="52dp" android:paddingEnd="14dp" android:paddingBottom="10dp" android:visibility="gone">
                    <com.google.android.material.slider.Slider android:id="@+id/sl_speed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0" android:valueTo="100" android:value="15" android:stepSize="1" style="@style/ZxSlider"/>
                    <TextView android:id="@+id/tv_speed_val" android:text="15%" android:textColor="@color/zx_amber" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AF59E0B" android:layout_marginStart="54dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_zx" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:text="Rapid Fire Rate" android:textColor="@color/zx_text" android:textSize="14sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Fire rate intensity boost" android:textColor="@color/zx_text_dim" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
