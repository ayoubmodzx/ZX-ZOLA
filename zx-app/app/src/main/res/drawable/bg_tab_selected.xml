    </item>
    <item android:left="0dp" android:width="3dp">
        <shape>
            <solid android:color="#7C4DFF"/>
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp"/>
        </shape>
    </item>
</layer-list>
